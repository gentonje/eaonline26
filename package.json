{
  "name": "online",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "dev": "concurrently \"EXPO_PUBLIC_SUPABASE_SERVICE_KEY=$SUPABASE_SERVICE_ROLE_KEY EXPO_WEBPACK_HOST=0.0.0.0 expo start --web --port 19006\" \"node server/index.js\"",
    "dev:frontend": "EXPO_PUBLIC_SUPABASE_SERVICE_KEY=$SUPABASE_SERVICE_ROLE_KEY EXPO_WEBPACK_HOST=0.0.0.0 expo start --web --port 19006",
    "dev:api": "node server/index.js",
    "build:web": "expo export --platform web"
  },
